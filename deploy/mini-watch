#!/bin/sh
# Runs one command of the program as the service user, with the data in /var/lib/mini-watch.
# deploy/install.sh copies this file to /usr/local/bin/mini-watch.
#
#   sudo mini-watch login      # log in to the car account
#   sudo mini-watch ntfy-test  # send a test notification to the phone
#   sudo mini-watch doctor     # check the settings, files and connections. Sends nothing.
set -eu

DATA=/var/lib/mini-watch

if [ "$(id -u)" -ne 0 ]; then
  echo "Run it with sudo: sudo mini-watch $*" >&2
  exit 1
fi
case "${1:-}" in
  login | ntfy-test | doctor) ;;
  run)
    # One stream connection for each account. A second copy breaks the service.
    echo "The service runs the program. Use: sudo systemctl start mini-watch" >&2
    exit 1
    ;;
  *)
    echo "Usage: sudo mini-watch login | ntfy-test | doctor" >&2
    exit 2
    ;;
esac

cd "$DATA"
umask 077
# install.sh replaces /opt/mini-watch/current/ with the real path of the release.
exec runuser -u miniwatch -- env MINI_WATCH_DATA="$DATA" /usr/local/bin/node /opt/mini-watch/current/mini_watch.mjs "$@"
